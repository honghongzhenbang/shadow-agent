{
  "paths": {
    "codexHome": "./runtime/empty-codex-home",
    "database": "./runtime/shadow-agent.sqlite",
    "knowledgeRoot": "./knowledge",
    "reportRoot": "./runtime/reports",
    "inboxRoots": [
      "./inbox/documents",
      "./inbox/feishu",
      "./inbox/yuque"
    ]
  },
  "collection": {
    "includeArchivedSessions": true,
    "maxEvidenceChars": 16000,
    "maxRawTraceChars": 2600,
    "maxDocumentBytes": 2097152,
    "projectScanDepth": 5,
    "maxProjectFiles": 200000,
    "gitCommitLimit": 200,
    "projectDigestDocumentLimit": 250,
    "projectDigestExcerptChars": 900,
    "maxRolloutLinesPerCycle": 50000,
    "maxRolloutLinesPerTransaction": 200,
    "digestTargetsPerCollection": 30,
    "digestThreadQuietSeconds": 120,
    "documentExtensions": [
      ".md",
      ".txt",
      ".rst",
      ".adoc",
      ".json",
      ".yaml",
      ".yml",
      ".toml",
      ".ini",
      ".csv",
      ".html"
    ],
    "ignoredDirectories": [
      ".git",
      ".svn",
      ".hg",
      "node_modules",
      "build",
      "dist",
      "out",
      "target",
      ".venv",
      "venv",
      "__pycache__",
      ".cache",
      ".idea",
      ".vs"
    ]
  },
  "service": {
    "collectionIntervalMinutes": 15,
    "databaseHeartbeatFailureRestartThreshold": 3,
    "fullReconcileIntervalHours": 24
  },
  "attention": {
    "schedule": {
      "enabled": true,
      "start": "08:00",
      "end": "19:00"
    },
    "directDebounceSeconds": 45,
    "selfAuthoredDebounceSeconds": 90,
    "groupDebounceSeconds": 300,
    "groupConversationActivationHours": 24,
    "botDebounceSeconds": 600,
    "documentChangeDebounceSeconds": 300,
    "localChangeDebounceSeconds": 120,
    "maxBatchWaitSeconds": 600,
    "recoveryMinutes": 10,
    "retryBaseSeconds": 30,
    "retryMaxSeconds": 900,
    "runTimeoutSeconds": 0,
    "waitSliceSeconds": 60
  },
  "reasoning": {
    "default": "medium",
    "byTask": {
      "message_triage": "medium",
      "direct_input": "high",
      "task_review": "high",
      "knowledge_curation": "high",
      "reminder": "low"
    }
  },
  "controllerBudgets": {
    "maxPromptBytes": 16384,
    "historyMessageLimit": 80,
    "warnDurationMs": 120000,
    "warnInputTokens": 12000,
    "warnCacheReadTokens": 48000,
    "warnTotalTokens": 64000,
    "warnToolCalls": 12,
    "retentionRows": 2000
  },
  "tracking": {
    "conditionCheckSeconds": 30,
    "conditionBatchSize": 20,
    "evidenceBatchSize": 200,
    "recoveryEvidenceRows": 2000,
    "candidateLimit": 20,
    "defaultTaskReviewMinutes": 120,
    "outboxPollSeconds": 3,
    "outboxBatchSize": 5
  },
  "taskSupervision": {
    "enabled": true,
    "auditMinutes": 5,
    "maxTasksPerAudit": 1,
    "defaultReviewMinutes": 120,
    "initialStaleMinutes": 60
  },
  "contextGraph": {
    "maxEvidencePerCycle": 2000,
    "changeLeaseSeconds": 900,
    "maxChangeBatch": 12,
    "maxContextBytes": 65536,
    "maxQueryDepth": 2,
    "maxKnowledgeBackfillPerCycle": 500,
    "ontologyFiles": [
      "./knowledge/ontology/core.json",
      "./knowledge/ontology/software-version.json"
    ]
  },
  "codex": {
    "mode": "sdk",
    "model": null,
    "sandbox": "read-only",
    "timeoutMinutes": 20,
    "workingDirectory": ".",
    "titleMaintenance": {
      "enabled": false,
      "intervalSeconds": 60,
      "maxThreadTitleChars": 160,
      "maxDigestTitleChars": 200,
      "agentCwdRoots": [
        "./runtime/openclaw-poc/workspace",
        "%USERPROFILE%\\Documents\\Codex\\shadow-agent"
      ]
    }
  },
  "feishu": {
    "enabled": false,
    "cliPath": "lark-cli.ps1",
    "identity": "user",
    "initialLookbackDays": 30,
    "pageLimit": 40,
    "personalSources": {
      "messages": {
        "enabled": true,
        "pollSeconds": 60
      },
      "documents": {
        "enabled": true,
        "pollSeconds": 600,
        "fetchBodies": true,
        "maxBodiesPerRun": 3
      },
      "tasks": {
        "enabled": true,
        "fallbackPollMinutes": 15,
        "realtimeEvent": "task.task.update_user_access_v2"
      },
      "approvals": {
        "enabled": true,
        "fallbackPollMinutes": 15,
        "realtimeEvents": [
          "approval.task.status_changed_v4",
          "approval.instance.status_changed_v4"
        ]
      }
    },
    "botDialogue": {
      "enabled": true,
      "realtimeEvent": "im.message.receive_v1"
    },
    "outboundMessages": {
      "mode": "hitl",
      "senderIdentity": "user"
    },
    "realtime": {
      "enabled": false,
      "reconnectSeconds": 5,
      "recoverySeconds": 30
    }
  }
}
