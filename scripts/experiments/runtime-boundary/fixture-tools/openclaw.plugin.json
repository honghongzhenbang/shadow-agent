{
  "id": "runtime-boundary-fixtures",
  "name": "Runtime Boundary Experimental Fixtures",
  "version": "0.1.0",
  "description": "Synthetic evidence and actions for isolated runtime comparisons.",
  "activation": { "onStartup": true },
  "contracts": {
